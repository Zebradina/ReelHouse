{
  "name": "reelhouse",
  "productName": "ReelHouse",
  "version": "1.6.0",
  "private": true,
  "description": "ReelHouse — a local-first home media centre for movies, TV shows and live TV guide, with desktop apps for macOS and Windows.",
  "main": "electron/main.js",
  "author": "ReelHouse",
  "license": "MIT",
  "scripts": {
    "start": "node server/start.js",
    "server": "node server/start.js",
    "desktop": "electron .",
    "demo": "node scripts/make-demo.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.reelhouse.app",
    "productName": "ReelHouse",
    "asar": true,
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/hls.js/dist/*.map",
      "!node_modules/hls.js/dist/*.d.ts",
      "!node_modules/hls.js/dist/*.d.mts",
      "!node_modules/hls.js/dist/hls.js",
      "!node_modules/hls.js/dist/hls.mjs",
      "!node_modules/hls.js/dist/hls-demo.js",
      "!node_modules/hls.js/dist/hls.light*",
      "!node_modules/hls.js/src/**",
      "!node_modules/hls.js/types/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
